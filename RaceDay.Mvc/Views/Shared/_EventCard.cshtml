@model EventListItemResponse
@{
    var enrolled = ViewData["Enrolled"] as bool? ?? false;
}
<article class="event-card h-100">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="event-card-banner @UiHelpers.TypeClass(Model.EventType)">
        <i class="bi @UiHelpers.TypeIcon(Model.EventType) banner-icon"></i>
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" alt="Banner for @Model.EventName" loading="lazy" onerror="this.remove()" />
        }
        <span class="type-chip"><i class="bi @UiHelpers.TypeIcon(Model.EventType)"></i> @Model.EventType</span>
        @if (enrolled)
        {
            <span class="enrolled-chip"><i class="bi bi-check-circle-fill"></i> Enrolled</span>
        }
    </a>
    <div class="event-card-body">
        <div class="event-date"><i class="bi bi-calendar3"></i> @UiHelpers.Date(Model.EventDate)</div>
        <h3 class="event-title"><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a></h3>
        <div class="event-meta">
            <span><i class="bi bi-geo-alt-fill"></i> @Model.Location</span>
            <span><i class="bi bi-signpost-split-fill"></i> @Model.Distance.ToString("0.##") km</span>
        </div>
    </div>
    <div class="event-card-footer">
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-accent btn-sm w-100">View event <i class="bi bi-arrow-right"></i></a>
    </div>
</article>
