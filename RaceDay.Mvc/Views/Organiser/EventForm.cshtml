@model EventFormViewModel
@{
    var isEdit = Model.EventId is not null;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}
<div class="mb-4">
    <span class="page-kicker">Organiser</span>
    <h1 class="page-title">@(isEdit ? "Edit event" : "Create a new event")</h1>
</div>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId" enctype="multipart/form-data" novalidate>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card-raceday">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" maxlength="150" placeholder="e.g. Sunrise 10K" />
                        <span asp-validation-for="EventName" class="field-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" maxlength="4000" placeholder="Tell participants what to expect: route, start time, facilities..."></textarea>
                        <span asp-validation-for="Description" class="field-error"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="EventDate" class="form-label">Date</label>
                        <input type="date" class="form-control" id="EventDate" name="EventDate" value="@Model.EventDate?.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EventDate" class="field-error"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            @foreach (var type in EventOptions.Types)
                            {
                                <option value="@type" selected="@string.Equals(Model.EventType, type, StringComparison.OrdinalIgnoreCase)">@type</option>
                            }
                        </select>
                        <span asp-validation-for="EventType" class="field-error"></span>
                    </div>
                    <div class="col-12 col-md-8">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" maxlength="200" placeholder="e.g. Sandton Central Park" />
                        <span asp-validation-for="Location" class="field-error"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" placeholder="10" />
                        <span asp-validation-for="Distance" class="field-error"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card-raceday">
                <h2 class="section-title">Banner image</h2>
                <div class="banner-preview" id="bannerPreview">
                    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
                    {
                        <img src="@Model.BannerImageUrl" alt="Current banner" id="bannerPreviewImg" onerror="this.remove()" />
                    }
                    else
                    {
                        <div class="banner-placeholder"><i class="bi bi-image"></i><span>No banner yet</span></div>
                    }
                </div>
                <label asp-for="Banner" class="form-label mt-3"></label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-preview-target="bannerPreview" />
                <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. Shown on the event page.</div>
                <span asp-validation-for="Banner" class="field-error"></span>
            </div>

            <div class="d-grid gap-2 mt-3">
                <button type="submit" class="btn btn-accent btn-lg">@(isEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
            </div>
        </div>
    </div>
</form>
