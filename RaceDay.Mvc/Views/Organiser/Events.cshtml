@model OrganiserDashboardResponse
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <span class="page-kicker">Organiser</span>
        <h1 class="page-title">My events</h1>
    </div>
    <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-circle-fill"></i> Create event</a>
</div>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-flag"></i>
        <h3>No events yet</h3>
        <p>Create your first event, add categories and open it for enrolment.</p>
        <a class="btn btn-accent" asp-action="Create">Create an event</a>
    </div>
}
else
{
    <div class="card-raceday p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-raceday align-middle mb-0">
                <thead>
                    <tr><th></th><th>Event</th><th>Date</th><th>Details</th><th class="text-center">Categories</th><th class="text-center">Enrolled</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Events.OrderByDescending(x => x.IsUpcoming).ThenBy(x => x.IsUpcoming ? x.EventDate.DayNumber : -x.EventDate.DayNumber))
                    {
                        <tr>
                            <td class="thumb-cell">
                                <div class="thumb @UiHelpers.TypeClass(e.EventType)">
                                    <i class="bi @UiHelpers.TypeIcon(e.EventType)"></i>
                                    @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                                    {
                                        <img src="@e.BannerImageUrl" alt="" loading="lazy" onerror="this.remove()" />
                                    }
                                </div>
                            </td>
                            <td>
                                <a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                                @if (!e.IsUpcoming)
                                {
                                    <span class="badge text-bg-secondary ms-1">Finished</span>
                                }
                            </td>
                            <td class="text-nowrap">@UiHelpers.ShortDate(e.EventDate)</td>
                            <td class="small">@e.EventType &middot; @e.Distance.ToString("0.##") km<br /><span class="text-muted">@e.Location</span></td>
                            <td class="text-center">@e.CategoryCount</td>
                            <td class="text-center"><span class="count-pill">@e.EnrolmentCount</span></td>
                            <td class="text-end text-nowrap">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Actions for @e.EventName">
                                    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@e.EventId" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                    <a class="btn btn-outline-secondary" asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventId" title="Categories"><i class="bi bi-tags"></i></a>
                                    <a class="btn btn-outline-secondary" asp-controller="Enrolments" asp-action="ForEvent" asp-route-eventId="@e.EventId" title="Enrolments"><i class="bi bi-people"></i></a>
                                    <a class="btn btn-outline-secondary" asp-controller="Results" asp-action="Entry" asp-route-eventId="@e.EventId" title="Results"><i class="bi bi-stopwatch"></i></a>
                                </div>
                                <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline confirm-form" data-confirm="Delete &quot;@e.EventName&quot;? Its categories, enrolments and results will be deleted too.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Delete"><i class="bi bi-trash3"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
