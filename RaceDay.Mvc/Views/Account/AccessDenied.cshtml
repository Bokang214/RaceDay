@{
    ViewData["Title"] = "Access denied";
    var user = Context.Session.GetSessionUser();
}
<div class="text-center py-5 error-page">
    <div class="error-code"><i class="bi bi-slash-circle"></i></div>
    <h1 class="display-6 mb-3">That area is not for your role</h1>
    <p class="lead text-muted mb-4">
        @if (user is null)
        {
            <text>Please log in to continue.</text>
        }
        else
        {
            <text>You are logged in as @(user.Role == "Organiser" ? "an Organiser" : "a Participant"), and this page belongs to the other side of RaceDay.</text>
        }
    </p>
    @if (user is null)
    {
        <a class="btn btn-accent" asp-controller="Account" asp-action="Login">Log in</a>
    }
    else if (user.IsOrganiser)
    {
        <a class="btn btn-accent" asp-controller="Organiser" asp-action="Dashboard">Go to my dashboard</a>
    }
    else
    {
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index">Go to events</a>
    }
</div>
