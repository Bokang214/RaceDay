@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var user = Context.Session.GetSessionUser();
    var f = Model.Filter;
}
<section class="hero mb-4">
    <div class="hero-inner">
        <span class="hero-kicker">The start line is here</span>
        <h1 class="hero-title">FIND YOUR NEXT <span>RACE</span></h1>
        <p class="hero-sub">Browse running, walking and cycling events, pick your category and enrol in seconds.</p>
        @if (user is null)
        {
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-accent btn-lg" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus-fill"></i> Create an account</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
            </div>
        }
    </div>
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="filter-bar card-raceday mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label" for="Search">Search</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" id="Search" name="Search" value="@f.Search" placeholder="Event name" maxlength="150" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="Type">Type</label>
            <select class="form-select" id="Type" name="Type">
                <option value="">All types</option>
                @foreach (var type in EventOptions.Types)
                {
                    <option value="@type" selected="@string.Equals(f.Type, type, StringComparison.OrdinalIgnoreCase)">@type</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="Location">Location</label>
            <input class="form-control" id="Location" name="Location" value="@f.Location" placeholder="City or venue" maxlength="200" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="From">From</label>
            <input type="date" class="form-control" id="From" name="From" value="@f.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="To">To</label>
            <input type="date" class="form-control" id="To" name="To" value="@f.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-5">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="IncludePast" name="IncludePast" value="true" checked="@f.IncludePast" />
                <label class="form-check-label" for="IncludePast">Include events that have already happened</label>
            </div>
        </div>
        <div class="col-12 col-md-4 d-flex gap-2 justify-content-md-end">
            <button type="submit" class="btn btn-accent"><i class="bi bi-funnel-fill"></i> Apply filters</button>
            @if (f.HasAny)
            {
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Clear</a>
            }
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-end mb-3">
    <h2 class="section-title mb-0">@(f.IncludePast ? "All events" : "Upcoming events")</h2>
    <span class="text-muted small">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events")</span>
</div>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-flag"></i>
        <h3>No events match your search</h3>
        <p>Try removing a filter, or check back soon: new events are added all the time.</p>
        @if (f.HasAny)
        {
            <a class="btn btn-accent" asp-controller="Home" asp-action="Index">Show all upcoming events</a>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            var viewData = new ViewDataDictionary(ViewData) { ["Enrolled"] = Model.EnrolledEventIds.Contains(ev.EventId) };
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" view-data="viewData" />
            </div>
        }
    </div>
}
